generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())

  fullName String
  email    String @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verified   DateTime?
  provider   String?
  providerId String?

  role             UserRole          @default(USER)
  cart             Cart?
  order            Order[]
  verificationCode VerificationCode?
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          Int           @id @default(autoincrement())
  name        String
  imageUrl    String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  categoryId  Int
  category    Category      @relation(fields: [categoryId], references: [id])
  items       ProductItem[]
  ingredients Ingredient[]  @relation("IngredientToProduct")
}

model ProductItem {
  id               Int                          @id @default(autoincrement())
  price            Int
  size             Int?
  pizzaType        Int?
  imageUrl         String?
  productId        Int
  cartItems        CartItem[]
  product          Product                      @relation(fields: [productId], references: [id])
  extraIngredients ProductItemExtraIngredient[]
}

model Ingredient {
  id                          Int                           @id @default(autoincrement())
  name                        String
  price                       Int
  imageUrl                    String
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  products                    Product[]                     @relation("IngredientToProduct")
  productItemExtras           ProductItemExtraIngredient[]
  cartItemExcludedIngredients CartItemExcludedIngredients[]
  cartItemExtraIngredients    CartItemExtraIngredients[]
}

model Cart {
  id          Int        @id @default(autoincrement())
  userId      Int?       @unique
  token       String
  totalAmount Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User?      @relation(fields: [userId], references: [id])
  cartItems   CartItem[]

  @@index([token])
}

model CartItem {
  id                Int      @id @default(autoincrement())
  productItemId     Int
  cartId            Int
  quantity          Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  totalPrice        Int      @default(0)
  customizationHash String?

  cart        Cart        @relation(fields: [cartId], references: [id])
  productItem ProductItem @relation(fields: [productItemId], references: [id])

  cartItemExcludedIngredients CartItemExcludedIngredients[]
  cartItemExtraIngredients    CartItemExtraIngredients[]

  @@index([cartId, productItemId])
  @@index([cartId, customizationHash])
}

model CartItemExcludedIngredients {
  cartItemId   Int
  ingredientId Int

  cartItem   CartItem   @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([cartItemId, ingredientId])
}

model CartItemExtraIngredients {
  cartItemId   Int
  ingredientId Int

  cartItem   CartItem   @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([cartItemId, ingredientId])
}

model Order {
  id          Int         @id @default(autoincrement())
  userId      Int?
  token       String      @unique
  totalAmount Int
  status      OrderStatus
  paymentID   String?
  items       Json
  fullName    String
  email       String
  phone       String
  address     String
  comment     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User?        @relation(fields: [userId], references: [id])
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  code      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, code])
}

model ProductItemExtraIngredient {
  id            Int @id @default(autoincrement())
  productItemId Int
  ingredientId  Int

  productItem ProductItem @relation(fields: [productItemId], references: [id])
  ingredient  Ingredient  @relation(fields: [ingredientId], references: [id])

  @@unique([productItemId, ingredientId])
}

model Story {
  id         Int         @id @default(autoincrement())
  title      String
  imageUrl   String  
  imageUrlMobile String     
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean     @default(true)
  priority   Int         @default(0)       
  textColor  TextColor   @default(LIGHT)    
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items      StoryItem[]
}

model StoryItem {
  id         Int       @id @default(autoincrement())
  storyId    Int
  story      Story     @relation(fields: [storyId], references: [id])
  title String
  description String?
  imageUrl   String
  order      Int      
  layout     LayoutType @default(TEXT_BOTTOM)  
  textColor  TextColor  @default(LIGHT)        
  showButton Boolean    @default(true)
  buttonText String?   
  linkUrl String?                         
  createdAt  DateTime  @default(now())
}

enum OrderStatus {
  PENDING
  SUCCEEDED
  CANCELLED
}

enum UserRole {
  USER
  ADMIN
}

enum LayoutType {
  TEXT_TOP        
  TEXT_BOTTOM     
  TEXT_CENTER
  TEXT_OVER_IMAGE 
}

enum TextColor {
  LIGHT     
  DARK      
  ACCENT    
  MUTED   
}